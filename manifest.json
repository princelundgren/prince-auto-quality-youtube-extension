{
  "manifest_version": 3,
  "name": "Prince Auto Quality for YouTube™",
  "version": "0.1.0",
  "description": "Starts YouTube videos at the quality you choose, with no switch or restart after playback begins.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/quality.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Prince Auto Quality for YouTube™",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "src/popup.html"
  }
}
